@model IEnumerable<KMC.Client.Models.RegistrationViewModel>
@{ ViewData["Title"] = "My Tickets"; }

<style>
    /* Cinematic Ticket Header */
    .ticket-hero {
        position: relative;
        height: 35vh;
        border-radius: 1.5rem;
        margin: 0 15px 40px 15px;
        overflow: hidden;
        background: linear-gradient(to right, rgba(139, 0, 0, 0.8), rgba(0, 0, 0, 0.5)), 
                    url('https://edwardscollection.com/media/pages/blog/kandy-perahera.webp?format=webp&token=bwQotzsOqeGrWr4uWKYez9XCrKdYC4nK4Io7c5X85W8%3D') center/cover no-repeat;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        box-shadow: 0 10px 30px rgba(139, 0, 0, 0.2);
    }

    .ticket-hero h1 {
        font-family: 'Georgia', serif;
        color: var(--theme-accent);
        font-size: 3.5rem;
        font-weight: 800;
        text-shadow: 2px 4px 10px rgba(0,0,0,0.5);
    }

    /* Ticket-Style Card Design */
    .ticket-card {
        border: none;
        border-radius: 1.25rem;
        background: #ffffff;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border-left: 8px solid var(--theme-accent);
        overflow: hidden;
    }

    .ticket-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 30px rgba(139, 0, 0, 0.1);
    }

    .ticket-stub-header {
        background: rgba(139, 0, 0, 0.03);
        border-bottom: 1px dashed #ddd;
        padding: 1rem 1.5rem;
    }

    .status-confirmed {
        background-color: #d4edda;
        color: #155724;
        font-weight: 700;
        font-size: 0.75rem;
        letter-spacing: 1px;
    }

    .organizer-tag {
        color: var(--theme-primary);
        font-weight: 600;
        font-size: 0.85rem;
    }

    .ticket-icon {
        color: var(--theme-accent);
        font-size: 1.1rem;
    }

    /* Empty state card */
    .empty-tickets-card {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(10px);
        border: 2px dashed var(--theme-accent);
        border-radius: 2rem;
    }
</style>

<div class="container-fluid p-0">
    <div class="ticket-hero">
        <div class="px-4">
            <h1>My Tickets</h1>
            <p class="lead text-white fw-bold">Your Gateway to Kandyan Heritage</p>
        </div>
    </div>
</div>

<div class="container pb-5">
    @if (Model == null || !Model.Any())
    {
        <div class="empty-tickets-card text-center py-5 shadow-sm mx-auto" style="max-width: 700px;">
            <div class="mb-4">
                <i class="bi bi-ticket-perforated" style="font-size: 4.5rem; color: var(--theme-accent);"></i>
            </div>
            <h3 class="fw-bold text-dark">No Active Tickets</h3>
            <p class="text-muted px-3">You haven't secured a spot for any events yet. Experience the magic of Kandy today!</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-5 mt-3 shadow-sm">
                Discover Events
            </a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var reg in Model)
            {
                <div class="col">
                    <div class="card h-100 ticket-card shadow-sm">
                        <div class="ticket-stub-header d-flex justify-content-between align-items-center">
                            <span class="badge rounded-pill status-confirmed px-3 py-2 text-uppercase">
                                <i class="bi bi-patch-check-fill me-1"></i> Valid Ticket
                            </span>
                            <span class="text-muted small fw-bold">REF: @reg.RegistrationId</span>
                        </div>

                        <div class="card-body p-4">
                            <h4 class="card-title fw-bold mb-1" style="color: var(--theme-text);">@reg.Title</h4>
                            <p class="organizer-tag mb-4">
                                <i class="bi bi-person-check-fill me-1"></i> @reg.OrganizerName
                            </p>
                            
                            <div class="small">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="ticket-icon me-3"><i class="bi bi-calendar3"></i></div>
                                    <div>
                                        <div class="text-muted fw-bold text-uppercase" style="font-size: 0.6rem;">Scheduled Date</div>
                                        <div class="fw-bold">@reg.EventDate.ToString("MMM dd, yyyy")</div>
                                        <div class="small text-muted">Starts at @reg.EventDate.ToString("h:mm tt")</div>
                                    </div>
                                </div>
                                
                                <div class="d-flex align-items-center">
                                    <div class="ticket-icon me-3"><i class="bi bi-geo-alt-fill"></i></div>
                                    <div>
                                        <div class="text-muted fw-bold text-uppercase" style="font-size: 0.6rem;">Venue</div>
                                        <div class="fw-bold">@reg.Location</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer bg-white border-top-0 p-4 pt-0 d-flex gap-2">
                            <a asp-controller="Event" asp-action="Details" asp-route-id="@reg.EventId" 
                               class="btn btn-outline-primary btn-sm flex-grow-1 rounded-pill fw-bold py-2">
                                View Info
                            </a>
                            
                            <form asp-action="Cancel" asp-route-id="@reg.EventId" method="post" 
                                  onsubmit="return confirm('Are you sure you want to cancel your ticket? This cannot be undone.');" 
                                  class="flex-grow-1">
                                <button type="submit" class="btn btn-outline-danger btn-sm w-100 rounded-pill fw-bold py-2">
                                    Cancel
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>