@model IEnumerable<KMC.Client.Models.RegistrationViewModel>
@{ ViewData["Title"] = "My Tickets"; }

<div class="container mt-5">
    <h1 class="mb-4"><i class="bi bi-ticket-perforated"></i> My Registered Events</h1>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center py-5 shadow-sm">
            <h4>You haven't registered for any events yet.</h4>
            <p>Check out the home page to discover upcoming events in Kandy!</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Browse Events</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var reg in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 bg-light">
                        <div class="card-body">
                            <span class="badge bg-success mb-2">Ticket Confirmed</span>
                            <h4 class="card-title fw-bold">@reg.Title</h4>
                            <p class="text-muted small">Organized by @reg.OrganizerName</p>
                            
                            <div class="mt-3">
                                <p class="mb-1"><strong><i class="bi bi-calendar"></i> Date:</strong> @reg.EventDate.ToString("MMM dd, yyyy 'at' h:mm tt")</p>
                                <p class="mb-0"><strong><i class="bi bi-geo-alt"></i> Location:</strong> @reg.Location</p>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-top-0 d-flex justify-content-between pb-3">
                            <a asp-controller="Event" asp-action="Details" asp-route-id="@reg.EventId" class="btn btn-outline-primary btn-sm">View Details</a>
                            
                            <form asp-action="Cancel" asp-route-id="@reg.EventId" method="post" onsubmit="return confirm('Are you sure you want to cancel your ticket?');">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Cancel Ticket</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>