@model IEnumerable<KMC.Client.Services.AttendeeViewModel>
@{ ViewData["Title"] = "Guest List"; }

<div class="container mt-5" style="max-width: 800px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people-fill text-primary"></i> Event Guest List</h2>
        <a asp-action="Dashboard" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-light text-center m-0 py-5">
                    <h5 class="text-muted">No one has registered for this event yet.</h5>
                </div>
            }
            else
            {
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">Attendee Name</th>
                            <th>Email Address</th>
                            <th>Registration Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var person in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@person.FullName</td>
                                <td><a href="mailto:@person.Email" class="text-decoration-none">@person.Email</a></td>
                                <td>@person.RegistrationDate.ToString("MMM dd, yyyy - h:mm tt")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>