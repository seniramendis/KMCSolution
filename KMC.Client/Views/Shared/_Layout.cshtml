@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KMC Events</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark mb-4 py-3 shadow-sm" style="background-color: var(--theme-primary);">
            <div class="container">
                <a class="navbar-brand fw-bold fs-4" asp-controller="Home" asp-action="Index" style="color: var(--theme-accent); letter-spacing: 1px;">
                    <i class="bi bi-calendar-event me-2"></i>KMC Solution
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white fw-semibold" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                    </ul>
                    
                    <ul class="navbar-nav align-items-center">
                        @if (Context.Session.GetString("JwtToken") != null)
                        {
                            if (Context.Session.GetString("Role") == "Organizer")
                            {
                                <li class="nav-item"><a class="nav-link text-white fw-semibold" asp-controller="Event" asp-action="Dashboard">Dashboard</a></li>
                            }
                            else
                            {
                                <li class="nav-item"><a class="nav-link text-white fw-semibold" asp-controller="Event" asp-action="MyRegistrations">My Tickets</a></li>
                            }
                            <li class="nav-item ms-3">
                                <span class="text-white me-3">Ayubowan, <span style="color: var(--theme-accent); font-weight: bold;">@Context.Session.GetString("FullName")</span></span>
                                <a class="btn btn-outline-light btn-sm rounded-pill px-3" asp-controller="Auth" asp-action="Logout">Logout</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link text-white fw-semibold" asp-controller="Auth" asp-action="Login">Login</a></li>
                            <li class="nav-item ms-2">
                                <a class="btn btn-sm rounded-pill px-4 fw-bold shadow-sm" style="background-color: var(--theme-accent); color: var(--theme-primary);" asp-controller="Auth" asp-action="Register">Get Started</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>