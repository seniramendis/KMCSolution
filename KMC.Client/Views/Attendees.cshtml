@model List<KMC.Client.Services.AttendeeViewModel>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Guest List</h2>
        <a href="/Dashboard" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">No one has registered for this event yet!</div>
    }
    else
    {
        <div class="card shadow-sm">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Registration Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var guest in Model)
                    {
                        <tr>
                            <td>@guest.FullName</td>
                            <td>@guest.Email</td>
                            <td>@guest.RegistrationDate.ToString("MMM dd, yyyy - hh:mm tt")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>