@{ ViewData["Title"] = "About Us"; }

<div class="container py-5">
    <div class="row align-items-center">
        <div class="col-md-6">
            <h1 class="display-4 fw-bold mb-4" style="color: var(--theme-primary); font-family: 'Georgia', serif;">Our Heritage</h1>
            <p class="lead text-muted">KMC Solution is dedicated to celebrating the rich cultural traditions of Kandy.</p>
            <p>We provide a seamless platform for exploring historical festivals, religious ceremonies, and local gatherings in the hill capital.</p>
            <div class="mt-4">
                <a asp-action="Index" class="btn btn-primary px-5 py-3 shadow">Explore Events</a>
            </div>
        </div>
        <div class="col-md-6 mt-5 mt-md-0 text-center">
            <img src="https://edwardscollection.com/media/pages/blog/kandy-perahera.webp?format=webp" 
                 class="img-fluid rounded-4 shadow-lg border border-3" style="border-color: var(--theme-accent) !important; max-height: 400px;" alt="Kandy Perahera">
        </div>
    </div>
</div>