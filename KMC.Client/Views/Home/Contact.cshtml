@{
    ViewData["Title"] = "Contact";
}

<style>
    
    .contact-wrapper {
        padding: 6rem 0;
    }

    .contact-hero {
        font-family: 'Georgia', serif;
        font-size: clamp(3rem, 5vw, 4.5rem);
        line-height: 1.1;
        color: var(--theme-primary);
        letter-spacing: -1px;
        margin-bottom: 4rem;
    }
    
    .contact-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 3px;
        color: var(--theme-accent);
        font-weight: 700;
        margin-bottom: 0.5rem;
        display: block;
    }

    .contact-detail {
        font-size: 1.3rem;
        color: #222;
        font-weight: 500;
        margin-bottom: 2.5rem;
    }

    .contact-link {
        color: #222;
        text-decoration: none;
        border-bottom: 2px solid transparent;
        transition: border-color 0.3s ease, color 0.3s ease;
    }

    .contact-link:hover {
        color: var(--theme-primary);
        border-color: var(--theme-accent);
    }

    
    .image-panel {
        height: 650px;
        border-radius: 0; 
        background: url('https://winningtours.lk/wp-content/uploads/2025/03/templeoftooth.jpg') center/cover no-repeat;
        box-shadow: -20px 20px 0px rgba(212, 175, 55, 0.4); 
    }
</style>

<div class="container contact-wrapper">
    <div class="row align-items-center g-5">
        
        <div class="col-lg-5 pe-lg-5">
            <h1 class="contact-hero fw-bold">Let's talk<br>culture.</h1>
            
            <div class="contact-info-block">
                <div>
                    <span class="contact-label">Drop a line</span>
                    <p class="contact-detail">
                        <a href="mailto:info@kmcsolution.com" class="contact-link">info@kmcsolution.com</a>
                    </p>
                </div>

                <div>
                    <span class="contact-label">Give us a ring</span>
                    <p class="contact-detail">
                        <a href="tel:+94753356254" class="contact-link">+94 75 335 6254</a>
                    </p>
                </div>

                <div>
                    <span class="contact-label">Headquarters</span>
                    <p class="contact-detail" style="line-height: 1.4;">
                        Governor’s Residence,<br>
                        Sri Dalada Thapowana Vihara Rd,<br>
                        Kandy<br />
                        Sri Lanka
                    </p>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="image-panel w-100"></div>
        </div>
        
    </div>
</div>