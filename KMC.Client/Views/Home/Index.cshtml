@model IEnumerable<KMC.Client.Models.EventViewModel>
@{ ViewData["Title"] = "Home"; }

<style>
    
    body {
        overflow-x: hidden;
    }

    
    .hero-breakout {
        width: 100vw;
        position: relative;
        left: 50%;
        transform: translateX(-50%);
        margin-top: -1.5rem; 
    }

    
    @@media (max-width: 991.98px) {
        .hero-breakout {
            margin-top: -2.5rem; 
        }
    }

    
    @@media (max-width: 575.98px) {
        .hero-breakout {
            margin-top: -3.2rem; 
        }
    }
</style>

<div class="hero-breakout mb-5">
    <div id="hero-carousel" class="position-relative" style="
        min-height: 45vh; 
        width: 100%; 
        margin: 0; 
        overflow: hidden; 
        background-color: var(--theme-primary);
        box-shadow: 0 10px 30px rgba(139, 0, 0, 0.2);">
        
        <div class="hero-slide active" id="slide-1" style="
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(to right, rgba(139, 0, 0, 0.75), rgba(0, 0, 0, 0.6)), 
                        url('https://media.timeout.com/images/101839215/750/422/image.jpg') center/cover no-repeat;
            display: flex; align-items: center; justify-content: center; transition: opacity 1.5s ease-in-out; opacity: 1; z-index: 5;">
            <div class="container text-center py-5">
                <h1 class="display-3 fw-bold mb-2" style="color: var(--theme-accent); font-family: 'Georgia', serif;">Ayubowan!</h1>
                <p class="lead text-white" style="font-size: 1.5rem; font-weight: 500;">Welcome to KMC Solution</p>
            </div>
        </div>

        <div class="hero-slide" id="slide-2" style="
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(to right, rgba(139, 0, 0, 0.75), rgba(0, 0, 0, 0.6)), 
                        url('https://winningtours.lk/wp-content/uploads/2025/03/templeoftooth.jpg') center/cover no-repeat;
            display: flex; align-items: center; justify-content: center; transition: opacity 1.5s ease-in-out; opacity: 0; z-index: 1;">
            <div class="container text-center py-5">
                <h1 class="display-4 fw-bold text-white mb-2" style="font-family: 'Georgia', serif;">Sacred Heritage</h1>
                <p class="lead" style="color: var(--theme-accent); font-size: 1.3rem;">Experience the spiritual heart of Kandy</p>
            </div>
        </div>

        <div class="hero-slide" id="slide-3" style="
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(to right, rgba(139, 0, 0, 0.75), rgba(0, 0, 0, 0.6)), 
                        url('https://cdn.audleytravel.com/1050/750/79/542845-traditional-kandyan-dancers.webp') center/cover no-repeat;
            display: flex; align-items: center; justify-content: center; transition: opacity 1.5s ease-in-out; opacity: 0; z-index: 1;">
            <div class="container text-center py-5">
                <h1 class="display-4 fw-bold mb-2" style="color: var(--theme-accent); font-family: 'Georgia', serif;">Rhythm & Dance</h1>
                <p class="lead text-white" style="font-size: 1.3rem;">Witness the legendary Kandyan traditional performers</p>
            </div>
        </div>

        <div class="hero-slide" id="slide-4" style="
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(to right, rgba(139, 0, 0, 0.75), rgba(0, 0, 0, 0.6)), 
                        url('https://edwardscollection.com/media/pages/blog/kandy-perahera.webp?format=webp&token=bwQotzsOqeGrWr4uWKYez9XCrKdYC4nK4Io7c5X85W8%3D') center/cover no-repeat;
            display: flex; align-items: center; justify-content: center; transition: opacity 1.5s ease-in-out; opacity: 0; z-index: 1;">
            <div class="container text-center py-5">
                <h1 class="display-4 fw-bold text-white mb-2" style="font-family: 'Georgia', serif;">The Grand Perahera</h1>
                <p class="lead" style="color: var(--theme-accent); font-size: 1.3rem;">Be part of Sri Lanka's most iconic festival</p>
            </div>
        </div>

        <div class="hero-slide" id="slide-5" style="
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(to right, rgba(139, 0, 0, 0.75), rgba(0, 0, 0, 0.6)), 
                        url('https://kandyandancing.com/wp-content/uploads/2023/12/Screenshot-122-1024x575-1.png') center/cover no-repeat;
            display: flex; align-items: center; justify-content: center; transition: opacity 1.5s ease-in-out; opacity: 0; z-index: 1;">
            <div class="container text-center py-5">
                <h1 class="display-4 fw-bold mb-2" style="color: var(--theme-accent); font-family: 'Georgia', serif;">Cultural Traditions</h1>
                <p class="lead text-white" style="font-size: 1.3rem;">Preserving our history through every movement</p>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <form method="get" class="row g-2 mb-5 justify-content-center">
        <div class="col-auto">
            <select name="category" class="form-select border-0 shadow-sm" style="border-radius: 50px; padding: 0.5rem 1.5rem;">
                <option value="">All Categories</option>
                <option value="Music" selected="@(ViewBag.Category == "Music" ? "selected" : null)">Music</option>
                <option value="Sports" selected="@(ViewBag.Category == "Sports" ? "selected" : null)">Sports</option>
                <option value="Culture" selected="@(ViewBag.Category == "Culture" ? "selected" : null)">Culture</option>
                <option value="Business" selected="@(ViewBag.Category == "Business" ? "selected" : null)">Business</option>
            </select>
        </div>
        <div class="col-auto">
            <input type="date" name="date" class="form-control border-0 shadow-sm" style="border-radius: 50px; padding: 0.5rem 1.5rem;" value="@ViewBag.Date" />
        </div>
        <div class="col-auto">
            <input type="text" name="location" class="form-control border-0 shadow-sm" style="border-radius: 50px; padding: 0.5rem 1.5rem;" placeholder="Search Location..." value="@ViewBag.Location" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary shadow-sm">Search Events</button>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 rounded-3 shadow-sm" role="alert">
            <strong><i class="bi bi-exclamation-triangle-fill me-2"></i>Connection Error</strong>
            <p class="mb-0 mt-1">@ViewBag.ErrorMessage</p>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <h2 class="mb-4 fw-bold" style="color: var(--theme-primary);">Upcoming Events</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert text-center py-5 shadow-sm border-0" style="background-color: var(--theme-card); border-radius: 1rem;">
            <i class="bi bi-calendar-x" style="font-size: 3rem; color: var(--theme-accent);"></i>
            <h4 class="mt-3 fw-bold text-dark">No events found</h4>
            <p class="text-muted">Try adjusting your search filters or check back later!</p>
            <a asp-action="Index" class="btn btn-outline-dark mt-2 rounded-pill px-4">Clear Filters</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var ev in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0" style="background-color: var(--theme-card); border-radius: 1rem; transition: transform 0.3s ease;">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between mb-3">
                                <span class="badge" style="background-color: var(--theme-primary); font-size: 0.85rem; padding: 0.5em 1em;">@ev.Category</span>
                                @if (ev.SpotsLeft <= 0)
                                {
                                    <span class="badge bg-danger" style="font-size: 0.85rem; padding: 0.5em 1em;">Sold Out</span>
                                }
                            </div>
                            <h4 class="card-title fw-bold mb-3" style="color: var(--theme-text);">@ev.Title</h4>
                            <div class="text-muted" style="font-size: 0.95rem;">
                                <p class="mb-2"><strong style="color: var(--theme-primary);"><i class="bi bi-calendar3 me-2"></i></strong> @ev.EventDate.ToString("MMM dd, yyyy 'at' h:mm tt")</p>
                                <p class="mb-0"><strong style="color: var(--theme-primary);"><i class="bi bi-geo-alt-fill me-2"></i></strong> @ev.Location</p>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-top-0 d-flex justify-content-between align-items-center p-4 pt-0">
                            <span class="fw-bold" style="color: var(--theme-accent);">@ev.SpotsLeft spots left</span>
                            <a asp-controller="Event" asp-action="Details" asp-route-id="@ev.Id" class="btn btn-primary btn-sm px-4 py-2">View Details</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const slides = document.querySelectorAll('.hero-slide');
            let currentIdx = 0;

            function rotateSlides() {
                slides[currentIdx].style.opacity = '0';
                slides[currentIdx].style.zIndex = '1';

                currentIdx = (currentIdx + 1) % slides.length;

                slides[currentIdx].style.opacity = '1';
                slides[currentIdx].style.zIndex = '5';
            }

            setInterval(rotateSlides, 5000);
        });
    </script>
}