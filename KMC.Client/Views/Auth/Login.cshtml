@model KMC.Client.Models.LoginViewModel
@{ ViewData["Title"] = "Log In"; }

<style>
    
    body {
        background-color: #FDF8F5; 
    }
    
    .login-wrapper {
        min-height: 80vh;
        display: flex;
        align-items: center;
    }
    
    .login-card {
        border: none;
        border-radius: 1rem;
        box-shadow: 0 12px 40px rgba(139, 0, 0, 0.12);
        overflow: hidden; 
        background: #ffffff;
    }
    
    .login-image {
        
        background-image: url('https://cdn.audleytravel.com/1050/750/79/542845-traditional-kandyan-dancers.webp'); 
        background-color: #2b2b2b; 
        background-size: cover;
        background-position: center;
        min-height: 480px;
        position: relative;
    }
    
    
    .login-image::after {
        content: '';
        position: absolute;
        top: 0; right: 0; bottom: 0; left: 0;
        background: linear-gradient(to right, rgba(139, 0, 0, 0.2), rgba(0,0,0,0.4));
        pointer-events: none;
    }
    
    .login-form-container {
        padding: 3.5rem;
    }
    
    
    .form-control:focus {
        box-shadow: 0 0 0 0.25rem rgba(212, 175, 55, 0.25);
        border-color: #D4AF37;
    }
    
    
    .btn-kandyan {
        background-color: #8B0000; 
        color: #FDF8F5;
        border: 2px solid #8B0000;
        border-radius: 50px;
        padding: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.8px;
        transition: all 0.3s ease;
    }
    
    .btn-kandyan:hover {
        background-color: #FDF8F5;
        color: #8B0000;
        border-color: #8B0000;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(139, 0, 0, 0.25);
    }
    
    .kandyan-accent {
        color: #8B0000;
        font-weight: 800;
    }
</style>

<div class="container login-wrapper py-5">
    <div class="row w-100 justify-content-center m-0">
        <div class="col-lg-10 col-xl-9">
            <div class="card login-card row flex-row flex-wrap">
                
                <div class="col-md-6 login-image d-none d-md-block"></div>
                
                <div class="col-md-6 d-flex align-items-center login-form-container">
                    <div class="w-100">
                        <h2 class="mb-4 text-center kandyan-accent">Ayubowan</h2>
                        <p class="text-center text-muted mb-4">Log in to manage your events and cultural registrations.</p>
                        
                        @if (TempData["Message"] != null)
                        {
                            <div class="alert alert-success rounded-3 border-0" style="background-color: #d4edda; color: #155724;">@TempData["Message"]</div>
                        }
                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger rounded-3 border-0" style="background-color: #f8d7da; color: #721c24;">
                                <i class="bi bi-exclamation-circle me-2"></i>@ViewBag.Error
                            </div>
                        }

                        <form asp-action="Login" method="post">
                            <div class="form-floating mb-3">
                                <input asp-for="Email" type="email" class="form-control" id="floatingEmail" placeholder="name@example.com" required />
                                <label asp-for="Email" for="floatingEmail" class="text-muted">Email address</label>
                            </div>
                            <div class="form-floating mb-4">
                                <input asp-for="Password" type="password" class="form-control" id="floatingPassword" placeholder="Password" required />
                                <label asp-for="Password" for="floatingPassword" class="text-muted">Password</label>
                            </div>
                            
                            <button type="submit" class="btn w-100 btn-kandyan mb-4">Sign In</button>
                        </form>
                        
                        <div class="text-center mt-2">
                            <span class="text-muted">Don't have an account yet?</span> 
                            <a asp-action="Register" class="text-decoration-none ms-1" style="color: #D4AF37; font-weight: bold;">Register here</a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>